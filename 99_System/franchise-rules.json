{
  "$schema": "./franchise-rules.schema.json",
  "description": "Domain routing and pattern matching registry for Canon multi-cosmology ingestion. Replace the example rules with the wikis of your source universes.",
  "rules": [
    {
      "franchise": "Universe_Primary",
      "patterns": [
        "*universe-primary.fandom.com*"
      ],
      "defaultCanonTier": "C-Secondary"
    },
    {
      "franchise": "Universe_Primary",
      "patterns": [
        "*primary-world.wiki*",
        "*primary-canon*"
      ],
      "defaultCanonTier": "G-Primary"
    },
    {
      "franchise": "Universe_Secondary",
      "patterns": [
        "*universe-secondary.fandom.com*"
      ],
      "defaultCanonTier": "C-Secondary"
    },
    {
      "franchise": "Universe_Secondary",
      "patterns": [
        "*secondary-world.wiki*",
        "*secondary-canon*"
      ],
      "defaultCanonTier": "G-Primary"
    },
    {
      "franchise": "Universe_Tertiary",
      "patterns": [
        "*universe-tertiary*",
        "*tertiary-world.wiki*"
      ],
      "defaultCanonTier": "W-Author-WoB"
    }
  ],
  "fallbackRule": {
    "fandomSubdomainPattern": true,
    "defaultFranchise": "General",
    "defaultCanonTier": "C-Secondary"
  }
}
