<!-- 
  Fandom / MediaWiki Portable Infobox Template: Location / Geography
  Optional Fandom Portable Infobox starting point. Adapt and test in the target wiki's sandbox.
-->
<infobox type="location">
    <title source="title">
        <default>{{PAGENAME}}</default>
    </title>
    <image source="image">
        <caption source="caption"/>
    </image>
    <group>
        <header>Geographical Data</header>
        <data source="type">
            <label>Location Type</label>
        </data>
        <data source="location">
            <label>Region / Realm</label>
        </data>
        <data source="cosmology">
            <label>Cosmology</label>
        </data>
        <data source="governing_body">
            <label>Governing Body</label>
        </data>
    </group>
    <group>
        <header>Demographics &amp; Infrastructure</header>
        <data source="inhabitants">
            <label>Notable Inhabitants</label>
        </data>
        <data source="connections">
            <label>Routes &amp; Connections</label>
        </data>
        <data source="amenities">
            <label>Key Landmarks</label>
        </data>
    </group>
</infobox>

