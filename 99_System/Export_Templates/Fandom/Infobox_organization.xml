<!-- 
  Fandom / MediaWiki Portable Infobox Template: Organization / Faction
  Optional Fandom Portable Infobox starting point. Adapt and test in the target wiki's sandbox.
-->
<infobox type="organization">
    <title source="name">
        <default>{{PAGENAME}}</default>
    </title>
    <image source="logo">
        <caption source="caption"/>
    </image>
    <group>
        <header>Institutional Structure</header>
        <data source="type">
            <label>Organization Type</label>
        </data>
        <data source="leader">
            <label>Supreme Leader</label>
        </data>
        <data source="headquarters">
            <label>Headquarters</label>
        </data>
        <data source="cosmology">
            <label>Cosmology</label>
        </data>
    </group>
    <group>
        <header>Political &amp; Military Relations</header>
        <data source="allies">
            <label>Allies</label>
        </data>
        <data source="enemies">
            <label>Adversaries</label>
        </data>
        <data source="status">
            <label>Status</label>
        </data>
    </group>
</infobox>

